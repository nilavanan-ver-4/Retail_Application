# Copy to .env (never commit .env). All values below are examples.
DEBUG=false
SECRET_KEY=change-me-generate-with-python-c-"import secrets;print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://retail:change-me@localhost:5432/retail
# Read-only source for `manage.py import_legacy` (the old Flask database)
# LEGACY_DATABASE_URL=postgres://retail_ro:change-me@localhost:5432/postgres
TIME_ZONE=Asia/Kuala_Lumpur
SECURE_SSL_REDIRECT=false
TRUST_PROXY_SSL_HEADER=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
COMPANY_NAME=ASKER ENTERPRISE
CURRENCY_SYMBOL=RM
TAX_DEFAULT_RATE=0.00
MEDIA_ROOT=./media
